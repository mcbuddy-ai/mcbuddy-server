# Services

## Headers

API_URL=<need to be configured>
API_NAME=<need to be configured>

## MongoDB

MONGO_INITDB_ROOT_USERNAME=<need to be configured>
MONGO_INITDB_ROOT_PASSWORD=<need to be configured>
MONGO_INITDB_DATABASE=<need to be configured>
MONGODB_DATABASE=<need to be configured>

## Redis

REDIS_HOST=<need to be configured>
REDIS_PORT=<need to be configured>
REDIS_PASSWORD=<need to be configured>
REDIS_DB=<need to be configured>

## Application

PORT=<need to be configured>
NODE_ENV=<need to be configured>

CHAT_TTL_SECONDS=<need to be configured>

MONGODB_URI=<need to be configured>
REDIS_URL=<need to be configured>

OPENROUTER_API_KEY=<need to be configured>
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# The agent's model must support tool calling (perplexity/sonar* doesn't).
OPENROUTER_API_MODEL=openai/gpt-5-mini
# Search context size for search_web: low, medium, high.
OPENROUTER_API_CTX=medium
# Online model used by the search_web tool.
SEARCH_MODEL=perplexity/sonar
# Optional: low, medium, high for models that reason.
OPENROUTER_REASONING_EFFORT=

## Agent

TOOL_TIMEOUT_MS=15000
MAX_AGENT_STEPS=8
MAX_ACTIVE_RUNS=200
SSE_PING_MS=15000

# Proxy Configuration

HTTP_PROXY=<need to be configured>
