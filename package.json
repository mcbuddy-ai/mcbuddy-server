{
  "name": "mcbuddy-server",
  "version": "1.1.0",
  "description": "🛠️⚡ Бэкенд для AI-ассистента MCBuddy — быстрый сервер на Bun с интеграцией OpenRouter и web search, обработкой запросов из Minecraft и Telegram. 🌟",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/application/entrypoint.ts --outdir dist/application --target bun",
    "test": "bun test"
  },
  "keywords": [
    "minecraft",
    "ai",
    "assistant",
    "openrouter",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bullmq": "^5.67.2",
    "fp-ts": "^2.16.10",
    "ioredis": "^5.8.2",
    "mongoose": "^9.0.0",
    "retry-ts": "^0.1.4",
    "tslog": "^4.10.2",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
